{
  "name": "dsh-reverse-proxy-connect",
  "version": "0.4.3",
  "description": "鎶?WorkBuddy锛堝浗鍐呯増 / 鍥介檯鐗堬級銆丵oder锛堝叏鐞冪増 / 鍥藉唴鐗堬級涓?Trae锛堝浗鍐呯増 / 鍥介檯鐗堬級璐﹀彿閲岀殑妯″瀷鎺ュ叆 DeepSeek Harness锛氬璐﹀彿姹犮€侀搴﹁秼鍔夸笌鑰楀敖棰勬祴銆?29 鑷姩鎹㈠彿銆佹瘡鏃ョ鍒般€佸浘鐗囪緭鍏ャ€佺敤閲忓巻鍙层€佷簨浠惰处鏈笌璐﹀彿娴嬭瘯銆侭ring WorkBuddy, Qoder and Trae account models into DeepSeek Harness with multi-account failover, credit forecast, daily check-in, image input, usage history, an event journal and account tests.",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.1",
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "workbuddy",
    "qoder",
    "trae",
    "model-provider",
    "reverse-proxy",
    "multi-account",
    "usage-stats",
    "usage-history",
    "credit-forecast",
    "account-health",
    "event-journal",
    "vision"
  ],
  "bin": {
    "dsh-reverse-proxy-connect": "lib/bin.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "verify": "node --test tests/*.test.mjs && node tests/client-credits.mjs",
    "test:client": "node tests/client-credits.mjs",
    "doctor": "node lib/bin.js doctor",
    "status": "node lib/bin.js status"
  },
  "files": [
    "lib",
    "client",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PinBoDHua/dsh-reverse-proxy-connect.git"
  },
  "homepage": "https://github.com/PinBoDHua/dsh-reverse-proxy-connect#readme",
  "bugs": {
