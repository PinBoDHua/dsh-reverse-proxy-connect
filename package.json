{
  "name": "dsh-reverse-proxy-connect",
  "version": "1.0.3",
  "description": "把 WorkBuddy（国内版 / 国际版）与 Qoder（全球版 / 国内版）账号里的模型接入 DeepSeek Harness：多账号池、额度自动切换、每日签到、图片输入、用量统计。Bring WorkBuddy and Qoder account models into DeepSeek Harness with multi-account failover, daily check-in, image input and usage stats.",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.1",
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "workbuddy",
    "qoder",
    "model-provider",
    "reverse-proxy",
    "multi-account",
    "usage-stats",
    "vision"
  ],
  "bin": {
    "dsh-reverse-proxy-connect": "lib/bin.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "verify": "node --test tests/*.test.mjs && node tests/client-credits.mjs",
    "test:client": "node tests/client-credits.mjs",
    "doctor": "node lib/bin.js doctor",
    "status": "node lib/bin.js status"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.1-rc.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.1-rc.1",
    "@deepseek-ai/dsh-home-paths": ">=0.2.1-rc.1",
    "@deepseek-ai/dsh-atomic-write": ">=0.2.1-rc.1",
    "@deepseek-ai/dsh-attachment": ">=0.2.1-rc.1",
    "@earendil-works/pi-ai": ">=1.1.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm-pi-ai": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-atomic-write": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PinBoDHua/dsh-reverse-proxy-connect.git"
  },
  "homepage": "https://github.com/PinBoDHua/dsh-reverse-proxy-connect#readme",
  "bugs": {
    "url": "https://github.com/PinBoDHua/dsh-reverse-proxy-connect/issues"
  },
  "author": {
    "name": "PinBoDHua"
  }
}
